NODE_ENV=development
PORT=4000
# Supabase users on IPv4-only networks should use the Session pooler URL from the dashboard Connect button.
# Example: postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://returngame:returngame@localhost:5432/returngame
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@returngame.site
ADMIN_PASSWORD=change-me
AWS_REGION=ap-northeast-2
S3_BUCKET=returngame-webgl-dev
S3_UPLOAD_PREFIX=uploads
CDN_BASE_URL=https://cdn.returngame.site
CORS_ORIGIN=http://localhost:5173
